  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "gs1:Product is strictly broader than the DPPO product class, so only a subclass axiom is justified. Stated in the GS1 section of the accompanying paper."
  } ],
  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
