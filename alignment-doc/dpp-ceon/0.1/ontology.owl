<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/dpp/alignment/dpp-ceon/"
     xml:base="https://w3id.org/dpp/alignment/dpp-ceon/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dpp="http://w3id.org/dpp#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:product="http://w3id.org/CEON/ontology/product/">
    <owl:Ontology rdf:about="https://w3id.org/dpp/alignment/dpp-ceon/">
        <rdfs:label>Alignment between the DPP ontology and CEON.</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/identifier -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/identifier"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://w3id.org/CEON/ontology/product/hasProductComponent -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/CEON/ontology/product/hasProductComponent"/>
    


    <!-- http://w3id.org/dpp#hasComponent -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/dpp#hasComponent">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/CEON/ontology/product/hasProductComponent"/>
    </owl:AnnotationProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://w3id.org/dpp#hasComponent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
        <owl:annotatedTarget rdf:resource="http://w3id.org/CEON/ontology/product/hasProductComponent"/>
        <dc:identifier>DPP_CEON_0002</dc:identifier>
        <terms:source>DPPCEON</terms:source>
        <rdfs:comment>Both properties relate a product to a component that is itself a product. Additional mapping, not discussed in the paper.</rdfs:comment>
    </owl:Axiom>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/CEON/ontology/product/Product -->


    <owl:Class rdf:about="http://w3id.org/CEON/ontology/product/Product"/>
    


    <!-- http://w3id.org/dpp#Product -->


    <owl:Class rdf:about="http://w3id.org/dpp#Product">
        <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/product/Product"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://w3id.org/dpp#Product"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://w3id.org/CEON/ontology/product/Product"/>
        <dc:identifier>DPP_CEON_0001</dc:identifier>
        <terms:source>DPPCEON</terms:source>
        <rdfs:comment>dpp:Product and ceon-product:Product share the ISO 59004:2024 product definition, but dpp:Product is scoped to the products of the built environment whereas ceon-product:Product is domain neutral. Stated in the section on semantic alignment informed by the ESPR in the accompanying paper, where this alignment gives the DPP ontology access to the ESPR model, batch and item levels through CEON.</rdfs:comment>
    </owl:Axiom>
</rdf:RDF>



